# EmailJS — https://www.emailjs.com
# 1. Create a free account
# 2. Add an Email Service (Gmail, SMTP, etc.) → copy the Service ID
# 3. Create an Email Template with these variables:
#      {{from_name}}   — nombre del remitente
#      {{from_phone}}  — celular
#      {{from_email}}  — email del remitente
#      {{message}}     — mensaje
#    Set "To Email" to: info@mdautoelevadores.com
# 4. Copy your Public Key from Account → API Keys
# 5. Fill the values below and rename this file to .env

VITE_EMAILJS_SERVICE_ID=service_kku2uwk
VITE_EMAILJS_TEMPLATE_ID=template_6etvzb1
VITE_EMAILJS_PUBLIC_KEY=sqZLR9Lzd8E0Ooind

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# 1. Create a widget (choose "Managed" challenge)
# 2. Copy the Site Key and paste it below
# 3. (For server-side verification) copy the Secret Key for your backend
VITE_TURNSTILE_SITE_KEY=
